venv/
.venv/

__pycache__/
*.py[cod]
*$py.class

.vscode/
.DS_Store

*.log
.env

# Runtime gerado pela aplicação
.secret_key
auth.json
auth.json.*.tmp
*.lock
config.json
config.json.bak
config.json.*.tmp
.write-test-*
*.bak
central_cameras.log*

# Pacotes de build
*.zip

