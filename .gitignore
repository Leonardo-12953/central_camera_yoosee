# Live Viewer integrado: config sem senha acompanha o projeto; senhas e
# arquivos gerados em execução nunca devem ser versionados/distribuídos.
!live_viewer/config.json
live_viewer/secrets.json
live_viewer/streams/*
!live_viewer/streams/.gitkeep
live_viewer/logs/*
!live_viewer/logs/.gitkeep
live_viewer/models/*
!live_viewer/models/.gitkeep
live_viewer/events/*
!live_viewer/events/.gitkeep
