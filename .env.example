# Copie este arquivo para ".env" e ajuste o que precisar.
# O .env é carregado automaticamente ao lado do executável/app.py.
# O app aceita UTF-8 (com ou sem BOM), UTF-16 e ANSI.
#
# IMPORTANTE (Windows): confira se o arquivo se chama exatamente ".env",
# e não ".env.txt". No Explorer, ative "Extensões de nomes de arquivos".

# --- Login (recomendado) ---
# Forma mais fácil: rode o comando abaixo e siga as instruções.
#   Windows:  CentralCameras.exe set-password
#   Linux:    ./CentralCameras set-password
#   Código:   python app.py set-password
#
# Ele grava APP_USERNAME e APP_PASSWORD_HASH neste .env automaticamente.
# Para gerar o hash manualmente: python app.py hash-password
# APP_USERNAME=admin
# APP_PASSWORD_HASH='cole_o_hash_aqui'

# Alternativa apenas para teste local (senha em texto puro):
# APP_PASSWORD=senha-em-texto-puro

# --- Rede ---
# 127.0.0.1 = somente este computador
# 0.0.0.0   = acessível por outros dispositivos da rede local
# HOST=127.0.0.1
# PORT=5000

# --- Comportamento ---
# OPEN_BROWSER=1
# SESSION_COOKIE_SECURE=0
# LOG_LEVEL=INFO
# LOG_TO_FILE=1
# SERVER_THREADS=8

# --- Limpeza automática ---
# A retenção mínima é de 2 dias e não pode ser reduzida pela interface.
# Para conferir o que seria apagado sem remover nada:
#   Windows:  CentralCameras.exe purge --dry-run
#   Linux:    ./CentralCameras purge --dry-run
# CLEANUP_INTERVAL_SECONDS=3600
